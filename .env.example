# Copy to .env, fill only locally, and chmod 600. Never commit credentials.
JARVIS_LOG_LEVEL=INFO

# Pi coding-agent RPC.
PI_CODING_AGENT_COMMAND=pi
PI_CODING_AGENT_ARGS=-p
PI_CODING_AGENT_PROMPT_FLAG=
PI_CODING_AGENT_WORKDIR=
PI_CODING_AGENT_RPC_TIMEOUT_SECONDS=1800
PI_PYTHON=.venv/bin/python
JARVIS_PI_MODEL=omlx-64/Qwen3.6-35B-A3B-4bit
JARVIS_PI_THINKING=high
JARVIS_PI_MODEL_OPTIONS=omlx-64/Qwen3.6-35B-A3B-4bit

# Private local scheduler.
JARVIS_SCHEDULER_TIMEOUT_SECONDS=7200
JARVIS_SCHEDULER_PI_MODEL=
# Optional comma-separated job=prefix output validation rules.
JARVIS_SCHEDULER_REQUIRED_OUTPUT_PREFIXES=

# Shared local OpenAI-compatible/oMLX endpoints.
OMLX_BASE_URL=http://<omlx-host>:8000
OMLX_64_BASE_URL=http://<omlx-64-host>:8000/v1
OMLX_API_KEY=
OMLX_PDF_MODEL=MarkItDown
BRIEFING_MODEL=Qwen3.6-35B-A3B-4bit
BRIEFING_OMLX_BASE_URL=http://<omlx-host>:8000/v1

# Transport-neutral local voice pipeline.
JARVIS_VOICE_BASE_URL=http://<voice-model-host>:8000/v1
JARVIS_VOICE_API_KEY=
JARVIS_VOICE_ASR_MODEL=mlx-community/whisper-large-v3-turbo-asr-4bit
JARVIS_VOICE_ASR_LANGUAGE=en
JARVIS_VOICE_LLM_MODEL=Qwen3.5-9B-6bit
JARVIS_VOICE_LLM_MAX_TOKENS=120
JARVIS_VOICE_LLM_TEMPERATURE=0.4
JARVIS_VOICE_LLM_TOP_P=0.9
JARVIS_VOICE_LLM_DISABLE_THINKING=1
JARVIS_VOICE_HISTORY_TURNS=4
JARVIS_VOICE_TTS_BACKEND=piper
JARVIS_VOICE_TTS_PIPER_REPO_ID=jgkawell/jarvis
JARVIS_VOICE_TTS_PIPER_QUALITY=high
JARVIS_VOICE_TTS_PIPER_LENGTH_SCALE=1.15
JARVIS_VOICE_TTS_PIPER_VOLUME=0.95
JARVIS_VOICE_TTS_PIPER_NOISE_SCALE=0.40
JARVIS_VOICE_TTS_PIPER_NOISE_W_SCALE=0.55
JARVIS_VOICE_TTS_SPEED=1.0
JARVIS_VOICE_STREAM_TTS=1
JARVIS_VOICE_STREAM_START_WORDS=0
JARVIS_VOICE_TTS_MAX_SEGMENTS=0
JARVIS_VOICE_TTS_MAX_CHARS_PER_SEGMENT=220
JARVIS_VOICE_TTS_STRIP_URLS=1
JARVIS_VOICE_TTS_STRIP_CODE=1
JARVIS_VOICE_TTS_STRIP_MARKDOWN=1
JARVIS_VOICE_TTS_STRIP_CHAT_MARKUP=1
JARVIS_VOICE_WAKE_WORD=jarvis,arvis,charvis,travis,darvish,charmavis
JARVIS_VOICE_GREETING_COOLDOWN_MINUTES=10
JARVIS_VOICE_GREETING_INCLUDE_STATUS=1
JARVIS_VOICE_PROCESSING_ACK_ENABLED=1
JARVIS_VOICE_PROCESSING_ACK_TEXT=Generating your response, sir.
JARVIS_VOICE_ASR_TIMEOUT_SECONDS=120
JARVIS_VOICE_LLM_TIMEOUT_SECONDS=120
JARVIS_VOICE_TTS_TIMEOUT_SECONDS=180
JARVIS_VOICE_MODEL_LOAD_TIMEOUT_SECONDS=240
JARVIS_VOICE_UNLOAD_BETWEEN_STAGES=0
JARVIS_VOICE_REQUEST_RETRIES=2
JARVIS_VOICE_REQUEST_RETRY_BACKOFF_SECONDS=0.75
JARVIS_VOICE_TTS_MAX_BYTES=104857600
JARVIS_VOICE_REQUIRE_CONFIGURED_MODELS=1

# Mac room-audio bridge and Raspberry Pi client tuning.
JARVIS_ROOM_AUDIO_HOST=0.0.0.0
JARVIS_ROOM_AUDIO_PORT=8791
JARVIS_ROOM_AUDIO_TOKEN=
JARVIS_ROOM_AUDIO_PI_MODEL=omlx-64/Qwen3.6-35B-A3B-4bit
JARVIS_ROOM_AUDIO_PI_THINKING=high
JARVIS_ROOM_AUDIO_PI_IDLE_NEW_SESSION_SECONDS=900
JARVIS_ROOM_AUDIO_TTS_LEADING_SILENCE_MS=1000
JARVIS_ROOM_AUDIO_PROCESSING_ACK_ENABLED=1
JARVIS_ROOM_AUDIO_PROCESSING_ACK_TEXT=Generating your response, sir.
JARVIS_ROOM_AUDIO_BT_PROFILE_SETTLE_SECONDS=0.45
JARVIS_ROOM_AUDIO_VAD_SILENCE_SECONDS=1.0
JARVIS_ROOM_AUDIO_VAD_MIN_UTTERANCE_SECONDS=0.5
JARVIS_ROOM_AUDIO_OPENWAKEWORD_NCPU=2
JARVIS_ROOM_AUDIO_LOCAL_WAKE_WORD_THRESHOLD=0.75
JARVIS_ROOM_AUDIO_BLUETOOTH_MAC=<bluetooth-device-mac>
JARVIS_ROOM_AUDIO_STARTUP_GREETING=1
JARVIS_ROOM_AUDIO_GREETING_ON_RECONNECT=1
JARVIS_ROOM_AUDIO_GREETING_TIMEOUT_SECONDS=30
JARVIS_ROOM_AUDIO_GREETING_ENABLED=1
JARVIS_ROOM_AUDIO_GREETING_TEXT=

# Native Apple-client control plane. Trusted-network mode is the free-profile default.
JARVISD_URL=http://127.0.0.1:8790
JARVISD_HOST=0.0.0.0
JARVISD_PORT=8790
JARVISD_AUTH_MODE=trusted-network
JARVISD_TRUSTED_CIDRS=127.0.0.0/8,::1/128,192.168.21.0/24,100.64.0.0/10
JARVISD_EVENT_TOKEN=
JARVIS_API_TOKEN=
JARVISD_ALLOWED_ORIGINS=
JARVISD_MAX_JSON_BODY_BYTES=65536
JARVISD_STATE_TIMEOUT=10
JARVISD_LOG_MAX_BYTES=1048576
JARVISD_LOG_BACKUP_COUNT=3
JARVISD_ROUTINE_REQUEST_LOG_INTERVAL=60
JARVISD_PURIFIER_WRITE_WAIT_SECONDS=15
JARVISD_TAILSCALE_IP=
JARVIS_EMIT_EVENTS=1

# Future direct Watch APNs remains disabled until paid enrollment and physical proof.
# Store the .p8 key outside Git in an owner-only directory/file (0700/0600).
JARVIS_APNS_ENABLED=0
JARVIS_APNS_TEAM_ID=
JARVIS_APNS_KEY_ID=
JARVIS_APNS_KEY_PATH=
JARVIS_APNS_PRODUCTION=0

# Google Cast and Spotify.
OPERATION_JARVIS_CAST_DEVICE=tv
OPERATION_JARVIS_CAST_TV_NAME=<tv-cast-friendly-name>
OPERATION_JARVIS_CAST_TV_HOST=<tv-cast-host>
OPERATION_JARVIS_CAST_SPEAKERS_NAME=<speaker-cast-friendly-name>
OPERATION_JARVIS_CAST_SPEAKERS_HOST=<speaker-cast-host>
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
SPOTIFY_SP_DC=
SPOTIFY_SP_KEY=

# TP-Link Kasa and VeSync credentials/configuration.
KASA_USERNAME=
KASA_PASSWORD=
KASA_PASSWORD_2=
KASA_DISCOVERY_TARGET=255.255.255.255
VESYNC_USERNAME=
VESYNC_PASSWORD=
VESYNC_TIME_ZONE=America/Toronto

# Optional browser, web, Google, GitHub, and model credentials.
EXA_API_KEY=
GOOGLE_API_KEY=
YOUTUBE_API_KEY=
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_DEFAULT_REGION=CA
GOOGLE_MAPS_DEFAULT_LANGUAGE=en
GOOGLE_MAPS_DEFAULT_LOCATION_LABEL=Pickering, Ontario, Canada
GOOGLE_MAPS_DEFAULT_LAT=43.8384
GOOGLE_MAPS_DEFAULT_LNG=-79.0868
GOOGLE_MAPS_DEFAULT_RADIUS_METERS=25000
GOOGLE_MAPS_ALLOW_GOOGLE_API_KEY_FALLBACK=0
GITHUB_TOKEN=
HF_TOKEN=
KAGGLE_USERNAME=
KAGGLE_KEY=
PI_BROWSER_PROFILE_DIR=
PI_BROWSER_PROFILE_DIRECTORY=
PI_BROWSER_DAEMON_URL=http://127.0.0.1:9225
PI_BROWSER_DAEMON_PORT=9225
PI_BROWSER_DAEMON_TOKEN_FILE=

# Guarded remote SSH tool.
JARVIS_SSH_HOSTS_CONFIG=.pi/ssh-hosts.json
JARVIS_SSH_DEFAULT_HOST=
JARVIS_SSH_IDENTITY_FILE=~/.ssh/id_ed25519
JARVIS_SSH_INTERACTIVE_IDLE_SECONDS=1800
JARVIS_SSH_INTERACTIVE_OUTPUT_BYTES=65536

# Minecraft companion bridge.
JARVIS_MINECRAFT_HOST=
JARVIS_MINECRAFT_SSH_USER=
JARVIS_MINECRAFT_SSH_KEY=~/.ssh/jarvis_dashboard_host
JARVIS_MINECRAFT_FROM=player
JARVIS_MINECRAFT_TARGET=jarvis
