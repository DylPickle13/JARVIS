+describe("opt-in hidden tool execution", () => {
+	async function runHidden(options: { resolve?: boolean; invalid?: boolean; block?: boolean; fail?: boolean }) {
+		let executions = 0;
+		const requests: string[][] = [];
+		const hidden: AgentTool = {
+			name: "hidden",
+			label: "Hidden",
+			description: "Not advertised",
+			parameters: Type.Object({ value: Type.String() }),
+			execute: async () => {
+				executions++;
+				if (options.fail) throw new Error("operation failed");
+				return { content: [{ type: "text", text: "real output" }], details: { preserved: true } };
+			},
+		};
+		const agent = new Agent({
+			resolveTool: options.resolve ? (name) => (name === hidden.name ? hidden : undefined) : undefined,
+			beforeToolCall: async () => ({
+				block: options.block,
+				reason: "permission denied",
+				addedToolNames: ["hidden"],
+				toolResultContent: [{ type: "text", text: "lazy guidance" }],
+			}),
+			streamFn: (_model, context) => {
+				requests.push((context.tools ?? []).map((tool) => tool.name));
+				const message =
+					requests.length === 1
+						? createAssistantToolUseMessage([
+								{
+									type: "toolCall",
+									id: "hidden_call",
+									name: "hidden",
+									arguments: options.invalid ? {} : { value: "ok" },
+								},
+							])
+						: createAssistantMessage("done");
+				const stream = new MockAssistantStream();
+				queueMicrotask(() =>
+					stream.push({ type: "done", reason: message.stopReason as "stop" | "toolUse", message }),
+				);
+				return stream;
+			},
+		});
+		await agent.prompt("call hidden");
+		const result = agent.state.messages.find((message) => message.role === "toolResult");
+		return { executions, result, requests };
+	}
+
+	it("does not resolve hidden tools by default", async () => {
+		const { result, executions } = await runHidden({});
+		expect(executions).toBe(0);
+		expect(result).toMatchObject({ isError: true, content: [{ type: "text", text: "Tool hidden not found" }] });
+	});
+
+	it("executes an opted-in hidden tool once without advertising it", async () => {
+		const { result, executions, requests } = await runHidden({ resolve: true });
+		expect(executions).toBe(1);
+		expect(requests.every((tools) => tools.length === 0)).toBe(true);
+		expect(result).toMatchObject({
+			isError: false,
+			addedToolNames: ["hidden"],
+			details: { preserved: true },
+			content: [
+				{ type: "text", text: "real output" },
+				{ type: "text", text: "lazy guidance" },
+			],
+		});
+	});
+
+	it("validates arguments before preflight or execution", async () => {
+		const { result, executions } = await runHidden({ resolve: true, invalid: true });
+		expect(executions).toBe(0);
+		expect(result).toMatchObject({ isError: true });
+		expect(result).not.toHaveProperty("addedToolNames");
+	});
+
+	it.each([{ block: true }, { fail: true }])("retains preflight annotations on failure: %j", async (options) => {
+		const { result, executions } = await runHidden({ resolve: true, ...options });
+		expect(executions).toBe(options.block ? 0 : 1);
+		expect(result).toMatchObject({ isError: true, addedToolNames: ["hidden"] });
+		if (result?.role === "toolResult") expect(result.content.at(-1)).toEqual({ type: "text", text: "lazy guidance" });
+	});
+});
diff --git a/packages/coding-agent/docs/extensions.md b/packages/coding-agent/docs/extensions.md
index ce13db6..6a941f8 100644
--- a/packages/coding-agent/docs/extensions.md
+++ b/packages/coding-agent/docs/extensions.md
@@ -3021,3 +3021,33 @@ All examples in [examples/extensions/](../examples/extensions/).
 | `inline-bash.ts` | Inline bash in tool calls | `on("tool_call")` |
 | `bash-spawn-hook.ts` | Adjust bash command, cwd, and env before execution | `createBashTool`, `spawnHook` |
 | `with-deps/` | Extension with npm dependencies | Package structure with `package.json` |
+
+### JARVIS patch: hidden tool execution (Pi 0.85.1)
+
+`pi.setLazyTools(names)` opts registered, allowed tools into execution while their
+schemas are inactive. It replaces an explicit allowlist, independently of
+`setActiveTools`; it does not expose schemas. Call it in `session_start` after
+registration. The allowlist is cleared when the extension runtime is rebuilt.
+To disable hidden execution, call `setLazyTools([])`; merely hiding a designated
+lazy tool with `setActiveTools` does not revoke its lazy designation. CLI/SDK
+allowlists and exclusions still apply and cannot be overridden by this API.
+
+Agent core's optional `resolveTool(name)` is a pure synchronous execution lookup,
+used both for batch scheduling and argument validation. It must not throw or
+perform side effects. Resolved tools retain their normal wrappers, execution
+mode, permission hooks, cancellation, and result processing. Unknown names are
+not resolved. No implicit retries or extra provider requests are introduced.
+
+An extension's normal `tool_call` hook can add its group with `setActiveTools`
+after argument validation. Pi records additive preflight activations on the
+original result (including blocked, failed, and cancelled calls). The hook can
+return `toolResultContent` to append a group playbook without replacing real tool
+output. This content is accumulated across handlers and preserved if a later
+handler returns a block. A throwing handler fails closed; activation metadata is
+retained, although guidance returned by an earlier handler may be unavailable.
+
+Explicit loading keeps the existing native deferred-loading path. Direct calls
+retain Pi's conservative prior-use safeguard: a tool used before its schema
+marker remains an immediate definition on later requests and may refresh the
+provider prefix once. Unused group siblings can still be deferred. This patch
+does not weaken that safeguard or hide schemas by rewriting provider payloads.
