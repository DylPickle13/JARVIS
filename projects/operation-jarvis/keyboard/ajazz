#!/bin/sh
# Always use this project's environment, independent of the caller's directory.
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ ! -x "$ROOT/.venv/bin/python" ]; then
  printf '%s\n' "Missing $ROOT/.venv. See $ROOT/README.md for setup." >&2
  exit 1
fi
exec "$ROOT/.venv/bin/python" "$ROOT/ajazz.py" "$@"
