+                   (*current_open_options_ & kIOHIDOptionsTypeSeizeDevice) &&
+                   requested_open_options_ == current_open_options_;
+      }
+      if (acknowledge) {
+        const bool ok = device && eligible && jarvis::razer::matches(*device) &&
+                        jarvis_razer_sender_.acknowledge();
+        done({ok ? jarvis::razer::outcome::transport_success : jarvis::razer::outcome::rejected,
+              ok ? kIOReturnSuccess : kIOReturnNotOpen});
+        return;
+      }
+      if (!device || !eligible || !jarvis::razer::matches(*device) ||
+          !jarvis_razer_sender_.submit(*device, settings, true, deadline, done)) {
+        done({jarvis::razer::outcome::rejected, kIOReturnNotOpen});
+      }
+    });
+  }
