+  void async_jarvis_ak820(nlohmann::json request,
+                         std::function<void(nlohmann::json)> completion) const {
+    enqueue_to_dispatcher([this, request = std::move(request), completion = std::move(completion)] {
+      if (!client_) { completion({{"status", "rejected"}, {"reason", "not_connected"}}); return; }
+      client_->async_request(nlohmann::json::to_msgpack(request),
+        [completion](auto error, auto buffer) {
+          try {
+            if (error || !buffer || buffer->empty() || buffer->size() > 2048) {
+              completion({{"status", "uncertain"}, {"reason", "ipc"}}); return;
+            }
+            completion(nlohmann::json::from_msgpack(*buffer));
+          } catch (...) { completion({{"status", "uncertain"}, {"reason", "invalid_response"}}); }
+        });
+    });
+  }
+
