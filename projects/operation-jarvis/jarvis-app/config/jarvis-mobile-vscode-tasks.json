    {
      "label": "JARVIS: Restart all Pi processes (preserve sessions)",
      "type": "shell",
      "command": "/usr/bin/python3 /Users/dylanrapanan/JARVIS/projects/operation-jarvis/jarvis-app/scripts/jarvis-mobile-vscode-restart.py --all",
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": true,
        "close": true
      },
      "runOptions": {
        "instanceLimit": 1
      },
      "hide": true
    },
    {
      "label": "JARVIS Mobile Pi 1 \u2014 jarvis-ios",
      "type": "shell",
      "command": "printf 'JARVIS_TASK_START_1\\nJARVIS_TASK_READY_1\\n'; exec /usr/bin/env -u TMUX /opt/homebrew/bin/tmux -L jarvis-mobile attach-session -f ignore-size -t '=jarvis-ios:'",
