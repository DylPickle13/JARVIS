# Default private: publish only individually reviewed source/docs/templates.
# New files and directories require review before adding an exception here.
/*
!/.gitignore
!/README.md
!/CLI.md
!/security
!/security_cli.py
!/test_security_cli.py
!/test_read_recovery.py
!/security_doorbell.py
!/security_doorbell_direct.py
!/test_security_doorbell.py
!/security_recording.py
!/test_security_recording.py
!/security_chime.py
!/security_chime_worker.mjs
!/security_chime_integrity.mjs
!/security_chime_transport.mjs
!/test_security_chime_transport.mjs
!/test_security_chime.py
!/security_smart_actions.py
!/test_security_smart_actions.py
!/security_events.py
!/test_security_events.py
!/security_video.py
!/test_security_video.py
!/security_audio.py
!/security_tts.py
!/go2rtc-microphone16.patch
!/go2rtc-doorbell-hevc.patch
!/AUDIO-QUALITY.md
!/test_security_audio.py
!/archive_probe.py
!/archive_download_probe.py
!/test_archive_download_probe.py
!/continuous_recording.py
!/requirements.txt
!/requirements-archive.txt
!/.env.example
!/camera.env.example
!/devices.example.json

# Explicit private categories (also covered by the default rule above).
.env
.env.*
!.env.example
/devices.json
/planned-devices.json
/.secrets/
/.locks/
/.video-runtime/
/private-snapshots/
/.audio-runtime/
/.audio-settings/
/.venv*/
/private-archive/
/private-smart-actions/
/private-notes/
/logs/
/runtime/
/data/
__pycache__/
*.py[cod]
*.log
*.jsonl
*.sqlite*
*.db
*.ts
*.mp4
*.jpg
*.png
# Household commissioning, inventory, storage and recording history.
/SD-CARD.md
/DOORBELL.md
/SETUP-TODAY.md
