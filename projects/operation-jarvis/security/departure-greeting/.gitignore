# Publish only reviewed source/docs/tests; never observations or runtime.
/*
!/.gitignore
!/README.md
!/departure
!/departure.py
!/runtime.py
!/speaker.py
!/watcher.py
!/person_gate.py
!/sensor_trial.py
!/identity_preflight.py
!/install.py
!/tests/
/tests/*
!/tests/test_departure.py
!/tests/test_trial.py
!/tests/test_person_gate.py
!/tests/test_sensor_trial.py
!/tests/test_identity_preflight.py
__pycache__/
*.py[cod]
*.log
*.json
*.jsonl
*.sqlite*
*.db
/runtime/
/data/
