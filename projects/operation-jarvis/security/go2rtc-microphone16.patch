+package tapo
+
+import (
+	"github.com/AlexxIT/go2rtc/pkg/core"
+	"testing"
+)
+
+func TestMicrophone16DoesNotChangeSpeaker(t *testing.T) {
+	for _, native := range []bool{false, true} {
+		c := &Client{native16: native}
+		audio := 0
+		for _, media := range c.GetMedias() {
+			if media.Kind != core.KindAudio {
+				continue
+			}
+			audio++
+			name, rate := core.CodecPCMA, uint32(8000)
+			if native && media.Direction == core.DirectionRecvonly {
+				name, rate = core.CodecPCMU, 16000
+			}
+			codec := media.Codecs[0]
+			if codec.Name != name || codec.ClockRate != rate {
+				t.Fatalf("native=%v direction=%s got %s/%d", native, media.Direction, codec.Name, codec.ClockRate)
+			}
+			if rate == 16000 && codec.PayloadType != 96 {
+				t.Fatal("16 kHz needs dynamic RTP payload type")
+			}
+		}
+		if audio != 2 {
+			t.Fatalf("want mic and speaker, got %d", audio)
+		}
+	}
+}
