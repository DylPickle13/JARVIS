# Transport-neutral Operation JARVIS voice pipeline.
# Copy required values into the repository-root private .env; never commit secrets.

JARVIS_VOICE_BASE_URL=http://<voice-model-host>:8000/v1
# Optional; blank falls back to OMLX_API_KEY.
JARVIS_VOICE_API_KEY=
JARVIS_VOICE_ASR_BACKEND=apple-speech
JARVIS_VOICE_ASR_FALLBACK_BACKEND=
JARVIS_VOICE_INTERRUPT_ASR_BACKEND=apple-dictation
JARVIS_VOICE_INTERRUPT_ASR_FALLBACK_BACKEND=
JARVIS_VOICE_ASR_LANGUAGE=en
JARVIS_VOICE_APPLE_ASR_HELPER=/path/to/JARVIS/projects/operation-jarvis/voice/apple_asr/.build/release/jarvis-apple-asr
JARVIS_VOICE_APPLE_ASR_LOCALE=en-CA
JARVIS_VOICE_APPLE_ASR_TIMEOUT_SECONDS=15
JARVIS_VOICE_APPLE_ASR_CONTEXTUAL_STRINGS=Jarvis,stop,Pickering,PowerConf,oMLX,family room light,family room TV,family room speakers,Air Purifier
JARVIS_VOICE_LLM_MODEL=Qwen3.5-9B-6bit
JARVIS_VOICE_LLM_MAX_TOKENS=120
JARVIS_VOICE_LLM_TEMPERATURE=0.4
JARVIS_VOICE_LLM_TOP_P=0.9
JARVIS_VOICE_LLM_DISABLE_THINKING=1
JARVIS_VOICE_HISTORY_TURNS=4

JARVIS_VOICE_TTS_BACKEND=piper
JARVIS_VOICE_TTS_PIPER_REPO_ID=jgkawell/jarvis
JARVIS_VOICE_TTS_PIPER_QUALITY=high
JARVIS_VOICE_TTS_PIPER_LENGTH_SCALE=1.15
JARVIS_VOICE_TTS_PIPER_VOLUME=0.95
JARVIS_VOICE_TTS_PIPER_NOISE_SCALE=0.40
JARVIS_VOICE_TTS_PIPER_NOISE_W_SCALE=0.55
JARVIS_VOICE_TTS_SPEED=1.0
JARVIS_VOICE_STREAM_TTS=1
JARVIS_VOICE_STREAM_START_WORDS=0
JARVIS_VOICE_TTS_MAX_SEGMENTS=0
JARVIS_VOICE_TTS_MAX_CHARS_PER_SEGMENT=220
JARVIS_VOICE_TTS_STRIP_URLS=1
JARVIS_VOICE_TTS_STRIP_CODE=1
JARVIS_VOICE_TTS_STRIP_MARKDOWN=1
JARVIS_VOICE_TTS_STRIP_CHAT_MARKUP=1

JARVIS_VOICE_WAKE_WORD=jarvis,arvis,charvis,travis,darvish,charmavis
JARVIS_VOICE_GREETING_COOLDOWN_MINUTES=10
JARVIS_VOICE_GREETING_INCLUDE_STATUS=1
JARVIS_VOICE_PROCESSING_ACK_ENABLED=1
JARVIS_VOICE_PROCESSING_ACK_TEXT=Generating your response, sir.

JARVIS_VOICE_ASR_TIMEOUT_SECONDS=120
JARVIS_VOICE_LLM_TIMEOUT_SECONDS=120
JARVIS_VOICE_TTS_TIMEOUT_SECONDS=180
JARVIS_VOICE_MODEL_LOAD_TIMEOUT_SECONDS=240
JARVIS_VOICE_UNLOAD_BETWEEN_STAGES=0
JARVIS_VOICE_REQUEST_RETRIES=2
JARVIS_VOICE_REQUEST_RETRY_BACKOFF_SECONDS=0.75
JARVIS_VOICE_TTS_MAX_BYTES=104857600
JARVIS_VOICE_REQUIRE_CONFIGURED_MODELS=1
